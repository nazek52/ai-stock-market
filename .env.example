# Copy to .env.local; never commit actual values.
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017/ai_stock_market?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=ai_stock_market
# Server-only credentials; create provider accounts before enabling live data.
FINNHUB_API_KEY=
MARKET_DATA_MODE=fixture
FINNHUB_REQUESTS_PER_MINUTE=30
MARKET_CACHE_SECONDS=60
MARKET_STALE_SECONDS=900
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
AI_MODE=fixture
GEMINI_API_KEY=
GEMINI_MODEL=
EMAIL_TRANSPORT=stream
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AI Stock Market <no-reply@localhost.test>
EMAIL_ENABLED=false
DIGEST_SCHEDULE_ENABLED=false
ALERT_SCHEDULE_ENABLED=false
ALERT_POLL_SECONDS=300
