{
  "name": "ai-stock-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup:local": "node scripts/setup-local.mjs",
    "services:up": "docker compose up -d --wait",
    "services:mongo": "node scripts/mongo-local.mjs",
    "services:mail": "pwsh -NoProfile -File scripts/mailpit-local.ps1",
    "services:down": "docker compose --profile jobs down",
    "services:jobs": "docker compose --profile jobs up -d inngest",
    "services:jobs:stop": "docker compose --profile jobs stop inngest",
    "production:check": "node --env-file-if-exists=.env.production.local scripts/validate-production.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/mongo-adapter": "1.7.7",
    "@fontsource-variable/inter": "5.3.0",
    "@google/genai": "2.29.1",
    "@tailwindcss/turbopack": "4.3.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "inngest": "4.23.0",
    "lucide-react": "1.57.0",
    "mongodb": "7.7.0",
    "next": "16.4.0",
    "nodemailer": "10.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "mongodb-memory-server": "11.3.0",
    "shadcn": "4.21.5",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
